# .env file for Odyssey Registry
ODY_DB_CONNECTION=mongodb://localhost:27017
# Add other environment variables as needed, e.g.:
# ODY_CLIENT_ID=...
# ODY_CLIENT_SECRET=...
ODY_AUTHORIZATION_URL=https://discord.com/oauth2/authorize
ODY_TOKEN_URL=https://discord.com/api/oauth2/token
ODY_REDIRECT_URL=http://odyssey.local:8080/identity/oauth/callback
ODY_REVOKE_URL=https://discord.com/api/oauth2/token/revoke
